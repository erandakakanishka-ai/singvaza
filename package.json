{
  "name": "singvaza",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-Server-Audio-Cost Karaoke & Vocal Mastering SaaS on Cloudflare Workers + D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute karomix-db --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute karomix-db --remote --file=./schema.sql",
    "test": "node --test tests/security.test.mjs tests/seo.test.mjs tests/karaoke-dsp.test.mjs tests/builtin-pages.test.mjs",
    "test:e2e": "node --test tests/browser.test.mjs tests/vocal-remover.test.mjs tests/redesign.test.mjs",
    "test:integration": "node --test tests/quota-cms.integration.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.6.3",
    "wrangler": "^3.114.17"
  }
}
